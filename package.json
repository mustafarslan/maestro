{
  "name": "maestro-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "build:binary": "pnpm run build:ui && tsc -b && bun build --compile --outfile dist/maestro apps/cli/dist/index.js",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p packages/ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:ui": "pnpm --filter @maestro/ui build && node scripts/embed-ui.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/google": "4.0.64",
    "@ai-sdk/openai": "4.0.60",
    "@ai-sdk/openai-compatible": "3.0.44",
    "@octokit/auth-app": "8.1.1",
    "@octokit/rest": "22.0.0",
    "@octokit/webhooks-methods": "6.0.0",
    "@types/picomatch": "4.0.2",
    "ai": "7.0.93",
    "picomatch": "4.0.4",
    "zod": "4.5.4",
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
