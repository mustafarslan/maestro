{
  "name": "maestro-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "build:binary": "bun build --compile --outfile dist/maestro apps/cli/src/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
