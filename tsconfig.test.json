{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@maestro/core": ["./packages/core/src/index.ts"],
      "@maestro/playbook": ["./packages/playbook/src/index.ts"]
    }
  },
  "include": ["packages/**/*.test.ts", "apps/**/*.test.ts", "packages/*/src/**/*.ts"]
}
